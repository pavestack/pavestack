{
  "name": "pavestack-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-catalog": "node scripts/generate-catalog.mjs",
    "dev": "npm run generate-catalog && vite --host 0.0.0.0",
    "build": "npm run generate-catalog && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . && tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "./node_modules/.bin/vitest run",
    "test:coverage": "./node_modules/.bin/vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "js-yaml": "^5.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "^5.0.0"
  }
}

{
  "name": "pavestack-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-catalog": "node scripts/generate-catalog.mjs",
    "dev": "npm run generate-catalog && vite --host 0.0.0.0",
    "build": "npm run generate-catalog && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . && tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "./node_modules/.bin/vitest run",
    "test:coverage": "./node_modules/.bin/vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "js-yaml": "^5.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.9"
  }
}
